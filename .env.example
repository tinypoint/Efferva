AGENTFRAME_DATABASE_URL=postgresql://agentframe:agentframe@postgres:5432/agentframe
# Optional OpenAI-compatible Responses API proxy and explicit model.
AGENTFRAME_CODEX_OPENAI_BASE_URL=
AGENTFRAME_CODEX_MODEL=
AGENTFRAME_SANDBOX_PROVIDER=docker
AGENTFRAME_SANDBOX_IMAGE=agentframe-sandbox:local
AGENTFRAME_DOCKER_NETWORK=agentframe
AGENTFRAME_PUBLIC_BASE_URL=http://localhost:8080
# The framework can boot without a key; model turns require one.
OPENAI_API_KEY=
