EFFERVA_DATABASE_URL=postgresql://efferva:efferva@postgres:5432/efferva
# Optional OpenAI-compatible Responses API proxy and explicit model.
EFFERVA_CODEX_OPENAI_BASE_URL=
EFFERVA_CODEX_MODEL=
EFFERVA_SANDBOX_PROVIDER=opensandbox
EFFERVA_SANDBOX_IMAGE=ghcr.io/openai/codex-universal:latest
EFFERVA_OPENSANDBOX_SERVER_URL=http://opensandbox-server:8090
EFFERVA_OPENSANDBOX_API_KEY=
EFFERVA_OPENSANDBOX_USE_SERVER_PROXY=true
EFFERVA_PUBLIC_BASE_URL=http://localhost:8080
# The framework can boot without a key; model turns require one.
OPENAI_API_KEY=
EFFERVA_CODEX_CONFIG_FILE=
