FROM node:22-alpine

WORKDIR /repo/examples/multi-session-codex/web
COPY packages/codex-client /repo/packages/codex-client
COPY examples/multi-session-codex/web/package.json \
     examples/multi-session-codex/web/package-lock.json ./
RUN npm ci

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
