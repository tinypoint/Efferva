# Linux wheel built from the current Efferva main branch.
EFFERVA_WHEEL_URL=http://host.docker.internal:8765/efferva-0.1.0-py3-none-linux_aarch64.whl

# cli-proxy-api is exposed by the host on port 8317.
EFFERVA_CODEX_OPENAI_BASE_URL=http://host.docker.internal:8317/v1
OPENAI_API_KEY=replace-with-cli-proxy-api-key
EFFERVA_CODEX_MODEL=gpt-5.4

# The example is pinned so upstream changes cannot silently break it.
VIBE_TRADING_REVISION=0e004d7a98097a01751c5dd6adafa1a3afa3817d
